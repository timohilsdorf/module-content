#!/bin/bash
# pre-push-Guard gegen die Merge-Timing-Falle (CLAUDE.md «Konventionen»):
# Commits, die NACH dem Merge eines Pull Requests auf dessen Branch
# gepusht werden, hängt GitHub an keinen PR mehr – sie liegen unsichtbar
# auf einem toten Branch (dreimal passiert). Dieser Hook fragt vor dem
# Push per REST, ob für den Ziel-Branch bereits ein GEMERGTER PR existiert,
# und blockt den Push dann mit Anleitung.
#
# Aktivieren (je Klon):  git config core.hooksPath scripts/git-hooks
#   – in Cloud-Sessions erledigt das scripts/install_pkgs.sh.
# Bewusst übergehen:     git push --no-verify
#
# REST statt `gh pr list`: GraphQL-Aufrufe (gh pr, gh issue) sind in
# Claude-Code-Cloud-Sessions gesperrt; `gh api repos/...` läuft dort über
# den GitHub-Proxy. Fail-open: ohne gh, ohne Netz oder bei API-Fehlern
# wird nur gewarnt – der Push geht durch.
remote="$1"
url="${2:-$(git config --get "remote.$remote.url" 2>/dev/null)}"
slug="$(printf '%s' "$url" | sed -E 's#^(git@github\.com:|https://github\.com/|ssh://git@github\.com/)##; s#\.git$##; s#/$##')"
case "$slug" in
  */*) ;;
  *) exit 0 ;;
esac
owner="${slug%%/*}"
if ! command -v gh >/dev/null 2>&1; then
  echo "[pre-push] gh fehlt – Merge-Status des PR-Branches nicht geprüft." >&2
  exit 0
fi

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/*) ;;
    *) continue ;;
  esac
  branch="${remote_ref#refs/heads/}"
  [ "$branch" = "main" ] && continue
  case "$local_sha" in
    0000000000000000000000000000000000000000) continue ;;  # Branch-Löschung
  esac
  if ! merged="$(gh api "repos/$slug/pulls?state=closed&head=$owner:$branch&per_page=10" \
        --jq '[.[] | select(.merged_at != null)] | length' 2>/dev/null)"; then
    echo "[pre-push] GitHub-API nicht erreichbar – Merge-Status von «$branch» nicht geprüft." >&2
    continue
  fi
  case "$merged" in
    ''|*[!0-9]*) continue ;;
  esac
  if [ "$merged" -gt 0 ]; then
    cat >&2 <<MELDUNG
✗ Push auf «$branch» blockiert: Für diesen Branch ist bereits ein Pull
  Request GEMERGED – neue Commits hingen an keinem PR mehr (Merge-Timing-
  Falle, s. CLAUDE.md «Konventionen»). Stattdessen:
    git fetch origin main
    git switch -c <neuer-branch> origin/main
    git cherry-pick <commits>
    git push -u origin <neuer-branch>     → neuer Pull Request
  Bewusst übergehen: git push --no-verify
MELDUNG
    status=1
  fi
done
exit $status
